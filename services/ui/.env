#######################################
# LOCAL DEVELOPMENT ENVIRONMENT
#######################################
#
# Debug mode for console
VITE_ENABLE_DEBUG=1
VITE_BASE_URL=/
#
#
# APIs Used By Application
#
VITE_API_URL=http://localhost:8080/api

#
# Authentication Details
#
# VITE_AUTH_MOCK_USER=USER
#   ==> mock authorization as regular user
#
# VITE_AUTH_MOCK_USER=ADMIN
#   ==> mock authorization as admin user
#
# VITE_AUTH_MOCK_USER=OFFICE_ADMIN
#   ==> mock authorization as office admin user (lrn and lrh)
#
# VITE_AUTH_MOCK_USER=
#   ==> send authentication requests to VITE_AUTH_HOST
#
VITE_AUTH_MOCK_USER=ADMIN
# VITE_APP_FY_DEFAULT=

#
# AUTH URLs
#
VITE_AUTH_HOST=https://identityc-test.cwbi.us/auth
#
VITE_AUTH_REDIRECT_URL=http://localhost:5173
